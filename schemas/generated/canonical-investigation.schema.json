{
  "$defs": {
    "InvestigationStatus": {
      "enum": [
        "planned",
        "running",
        "blocked",
        "completed",
        "cancelled"
      ],
      "title": "InvestigationStatus",
      "type": "string"
    },
    "InvestigationStep": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Evidence Ids",
          "type": "array"
        },
        "performed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Performed At"
        },
        "performed_by": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Performed By"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "step_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "description",
        "status"
      ],
      "title": "InvestigationStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assigned_to": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assigned To"
    },
    "conclusion": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conclusion"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1024,
      "title": "Evidence Ids",
      "type": "array"
    },
    "hypothesis": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Hypothesis",
      "type": "string"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 5,
      "title": "Incident Id",
      "type": "string"
    },
    "investigation_id": {
      "maxLength": 128,
      "minLength": 5,
      "title": "Investigation Id",
      "type": "string"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Labels",
      "type": "array",
      "uniqueItems": true
    },
    "record_type": {
      "const": "investigation",
      "default": "investigation",
      "title": "Record Type",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/InvestigationStatus"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/InvestigationStep"
      },
      "maxItems": 1024,
      "title": "Steps",
      "type": "array"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "investigation_id",
    "incident_id",
    "status",
    "hypothesis"
  ],
  "title": "InvestigationRecord",
  "type": "object"
}
