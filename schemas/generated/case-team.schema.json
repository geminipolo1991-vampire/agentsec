{
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "pattern": "^(analyst|system|workload)://[A-Za-z0-9_.@/-]+$",
      "title": "Created By",
      "type": "string"
    },
    "description": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Description",
      "type": "string"
    },
    "member_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Member Ids",
      "type": "array"
    },
    "name": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "team_id": {
      "pattern": "^team://[A-Za-z0-9_.@/-]+$",
      "title": "Team Id",
      "type": "string"
    },
    "team_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Team Sha256",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "team_id",
    "name",
    "description",
    "member_ids",
    "created_by",
    "created_at",
    "team_sha256"
  ],
  "title": "CaseTeam",
  "type": "object"
}
