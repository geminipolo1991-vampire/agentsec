{
  "$defs": {
    "ProviderKind": {
      "enum": [
        "openai",
        "anthropic"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "RouteStage": {
      "enum": [
        "candidate",
        "shadow",
        "active",
        "retired"
      ],
      "title": "RouteStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_requests_last_minute": {
      "minimum": 0,
      "title": "Budget Requests Last Minute",
      "type": "integer"
    },
    "budget_tokens_today": {
      "minimum": 0,
      "title": "Budget Tokens Today",
      "type": "integer"
    },
    "calculated_at": {
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    },
    "circuit_open_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Circuit Open Until"
    },
    "circuit_state": {
      "pattern": "^(closed|open)$",
      "title": "Circuit State",
      "type": "string"
    },
    "consecutive_failures": {
      "minimum": 0,
      "title": "Consecutive Failures",
      "type": "integer"
    },
    "failed_calls": {
      "minimum": 0,
      "title": "Failed Calls",
      "type": "integer"
    },
    "in_flight": {
      "minimum": 0,
      "title": "In Flight",
      "type": "integer"
    },
    "last_error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error Code"
    },
    "last_latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Latency Ms"
    },
    "provider": {
      "$ref": "#/$defs/ProviderKind"
    },
    "qualification_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qualification Id"
    },
    "route_id": {
      "title": "Route Id",
      "type": "string"
    },
    "route_revision": {
      "title": "Route Revision",
      "type": "integer"
    },
    "secret_ready": {
      "title": "Secret Ready",
      "type": "boolean"
    },
    "stage": {
      "$ref": "#/$defs/RouteStage"
    },
    "successful_calls": {
      "minimum": 0,
      "title": "Successful Calls",
      "type": "integer"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "route_id",
    "route_revision",
    "provider",
    "stage",
    "circuit_state",
    "consecutive_failures",
    "successful_calls",
    "failed_calls",
    "secret_ready",
    "budget_requests_last_minute",
    "budget_tokens_today",
    "in_flight",
    "calculated_at"
  ],
  "title": "ProviderHealth",
  "type": "object"
}
