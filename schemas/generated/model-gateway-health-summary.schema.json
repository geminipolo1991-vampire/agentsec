{
  "$defs": {
    "ProviderHealth": {
      "additionalProperties": false,
      "properties": {
        "budget_requests_last_minute": {
          "minimum": 0,
          "title": "Budget Requests Last Minute",
          "type": "integer"
        },
        "budget_tokens_today": {
          "minimum": 0,
          "title": "Budget Tokens Today",
          "type": "integer"
        },
        "calculated_at": {
          "format": "date-time",
          "title": "Calculated At",
          "type": "string"
        },
        "circuit_open_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Circuit Open Until"
        },
        "circuit_state": {
          "pattern": "^(closed|open)$",
          "title": "Circuit State",
          "type": "string"
        },
        "consecutive_failures": {
          "minimum": 0,
          "title": "Consecutive Failures",
          "type": "integer"
        },
        "failed_calls": {
          "minimum": 0,
          "title": "Failed Calls",
          "type": "integer"
        },
        "in_flight": {
          "minimum": 0,
          "title": "In Flight",
          "type": "integer"
        },
        "last_error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error Code"
        },
        "last_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Latency Ms"
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind"
        },
        "qualification_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualification Id"
        },
        "route_id": {
          "title": "Route Id",
          "type": "string"
        },
        "route_revision": {
          "title": "Route Revision",
          "type": "integer"
        },
        "secret_ready": {
          "title": "Secret Ready",
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/RouteStage"
        },
        "successful_calls": {
          "minimum": 0,
          "title": "Successful Calls",
          "type": "integer"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "route_id",
        "route_revision",
        "provider",
        "stage",
        "circuit_state",
        "consecutive_failures",
        "successful_calls",
        "failed_calls",
        "secret_ready",
        "budget_requests_last_minute",
        "budget_tokens_today",
        "in_flight",
        "calculated_at"
      ],
      "title": "ProviderHealth",
      "type": "object"
    },
    "ProviderKind": {
      "enum": [
        "openai",
        "anthropic"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "RouteStage": {
      "enum": [
        "candidate",
        "shadow",
        "active",
        "retired"
      ],
      "title": "RouteStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_routes": {
      "minimum": 0,
      "title": "Active Routes",
      "type": "integer"
    },
    "calculated_at": {
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    },
    "open_circuits": {
      "minimum": 0,
      "title": "Open Circuits",
      "type": "integer"
    },
    "policy_version": {
      "default": "model-gateway-2026-07-24.1",
      "title": "Policy Version",
      "type": "string"
    },
    "prompts": {
      "minimum": 0,
      "title": "Prompts",
      "type": "integer"
    },
    "providers": {
      "items": {
        "$ref": "#/$defs/ProviderHealth"
      },
      "title": "Providers",
      "type": "array"
    },
    "qualified_routes": {
      "minimum": 0,
      "title": "Qualified Routes",
      "type": "integer"
    },
    "routes": {
      "minimum": 0,
      "title": "Routes",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "prompts",
    "routes",
    "active_routes",
    "qualified_routes",
    "open_circuits",
    "providers",
    "calculated_at"
  ],
  "title": "ModelGatewayHealthSummary",
  "type": "object"
}
