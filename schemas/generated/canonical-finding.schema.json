{
  "$defs": {
    "FindingStatus": {
      "enum": [
        "open",
        "acknowledged",
        "investigating",
        "contained",
        "closed"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alert_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Alert Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entity_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Entity Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "finding_id": {
      "maxLength": 128,
      "minLength": 5,
      "title": "Finding Id",
      "type": "string"
    },
    "finding_type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Finding Type",
      "type": "string"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Labels",
      "type": "array",
      "uniqueItems": true
    },
    "policy_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "record_type": {
      "const": "finding",
      "default": "finding",
      "title": "Record Type",
      "type": "string"
    },
    "risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Score",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus",
      "default": "open"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "finding_id",
    "finding_type",
    "alert_ids",
    "entity_ids",
    "evidence_ids",
    "severity",
    "risk_score",
    "policy_version"
  ],
  "title": "FindingRecord",
  "type": "object"
}
