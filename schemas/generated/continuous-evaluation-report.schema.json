{
  "$defs": {
    "CandidateKind": {
      "enum": [
        "deterministic",
        "recorded_model",
        "live_model"
      ],
      "title": "CandidateKind",
      "type": "string"
    },
    "CaseExecutionStatus": {
      "enum": [
        "completed",
        "invalid_output",
        "error"
      ],
      "title": "CaseExecutionStatus",
      "type": "string"
    },
    "ContinuousEvaluationMetrics": {
      "additionalProperties": false,
      "properties": {
        "abstention_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Abstention Rate",
          "type": "number"
        },
        "alert_precision": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Alert Precision",
          "type": "number"
        },
        "attack_cases": {
          "minimum": 0,
          "title": "Attack Cases",
          "type": "integer"
        },
        "benign_cases": {
          "minimum": 0,
          "title": "Benign Cases",
          "type": "integer"
        },
        "benign_task_completion_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Benign Task Completion Rate",
          "type": "number"
        },
        "brier_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Brier Score",
          "type": "number"
        },
        "cases": {
          "minimum": 0,
          "title": "Cases",
          "type": "integer"
        },
        "decision_exact_agreement_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Decision Exact Agreement Rate",
          "type": "number"
        },
        "detector_f1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Detector F1",
          "type": "number"
        },
        "detector_recall": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Detector Recall",
          "type": "number"
        },
        "evidence_validity_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Validity Rate",
          "type": "number"
        },
        "expected_calibration_error": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expected Calibration Error",
          "type": "number"
        },
        "false_block_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "False Block Rate",
          "type": "number"
        },
        "forbidden_effect_attack_success_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Forbidden Effect Attack Success Rate",
          "type": "number"
        },
        "mean_latency_ms": {
          "minimum": 0.0,
          "title": "Mean Latency Ms",
          "type": "number"
        },
        "model_invocations": {
          "minimum": 0,
          "title": "Model Invocations",
          "type": "integer"
        },
        "safe_action_agreement_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Safe Action Agreement Rate",
          "type": "number"
        },
        "schema_validity_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Schema Validity Rate",
          "type": "number"
        },
        "selective_accuracy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Selective Accuracy",
          "type": "number"
        },
        "severity_exact_agreement_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Severity Exact Agreement Rate",
          "type": "number"
        },
        "severity_within_one_agreement_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Severity Within One Agreement Rate",
          "type": "number"
        }
      },
      "required": [
        "cases",
        "attack_cases",
        "benign_cases",
        "alert_precision",
        "detector_recall",
        "detector_f1",
        "forbidden_effect_attack_success_rate",
        "benign_task_completion_rate",
        "false_block_rate",
        "severity_exact_agreement_rate",
        "severity_within_one_agreement_rate",
        "evidence_validity_rate",
        "decision_exact_agreement_rate",
        "safe_action_agreement_rate",
        "model_invocations",
        "abstention_rate",
        "selective_accuracy",
        "brier_score",
        "expected_calibration_error",
        "schema_validity_rate",
        "mean_latency_ms"
      ],
      "title": "ContinuousEvaluationMetrics",
      "type": "object"
    },
    "DecisionAction": {
      "enum": [
        "allow",
        "allow_with_obligations",
        "require_approval",
        "deny"
      ],
      "title": "DecisionAction",
      "type": "string"
    },
    "EvaluationCandidateMetadata": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[a-z][a-z0-9_-]{2,63}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "exact_model_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Exact Model Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CandidateKind"
        },
        "live_provider_calls": {
          "title": "Live Provider Calls",
          "type": "boolean"
        },
        "provider": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "qualification_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualification Sha256"
        },
        "qualified": {
          "title": "Qualified",
          "type": "boolean"
        },
        "route_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Route Sha256",
          "type": "string"
        },
        "runtime_authority": {
          "const": false,
          "default": false,
          "title": "Runtime Authority",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "kind",
        "provider",
        "exact_model_id",
        "route_sha256",
        "qualified",
        "live_provider_calls"
      ],
      "title": "EvaluationCandidateMetadata",
      "type": "object"
    },
    "EvaluationCaseResult": {
      "additionalProperties": false,
      "properties": {
        "abstained": {
          "title": "Abstained",
          "type": "boolean"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "cited_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Cited Evidence Refs",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "dataset_split": {
          "title": "Dataset Split",
          "type": "string"
        },
        "effect_allowed": {
          "title": "Effect Allowed",
          "type": "boolean"
        },
        "enforced_action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_valid": {
          "title": "Evidence Valid",
          "type": "boolean"
        },
        "expected_action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "expected_alert_types": {
          "items": {
            "type": "string"
          },
          "title": "Expected Alert Types",
          "type": "array"
        },
        "expected_severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ]
        },
        "forbidden_effect_completed": {
          "title": "Forbidden Effect Completed",
          "type": "boolean"
        },
        "latency_ms": {
          "maximum": 300000,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_completed": {
          "title": "Model Completed",
          "type": "boolean"
        },
        "model_invoked": {
          "title": "Model Invoked",
          "type": "boolean"
        },
        "outcome_correct": {
          "title": "Outcome Correct",
          "type": "boolean"
        },
        "predicted_alert_types": {
          "items": {
            "type": "string"
          },
          "title": "Predicted Alert Types",
          "type": "array"
        },
        "predicted_severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposed_action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "required_benign_effect_completed": {
          "title": "Required Benign Effect Completed",
          "type": "boolean"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CaseExecutionStatus"
        },
        "unknown_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Evidence Refs",
          "type": "array"
        },
        "use_case": {
          "title": "Use Case",
          "type": "string"
        },
        "variant": {
          "$ref": "#/$defs/SimulationVariant"
        }
      },
      "required": [
        "case_id",
        "use_case",
        "dataset_split",
        "variant",
        "status",
        "expected_alert_types",
        "predicted_alert_types",
        "expected_severity",
        "predicted_severity",
        "expected_action",
        "proposed_action",
        "enforced_action",
        "effect_allowed",
        "forbidden_effect_completed",
        "required_benign_effect_completed",
        "evidence_valid",
        "cited_evidence_refs",
        "unknown_evidence_refs",
        "model_invoked",
        "model_completed",
        "abstained",
        "confidence",
        "outcome_correct",
        "latency_ms",
        "result_sha256"
      ],
      "title": "EvaluationCaseResult",
      "type": "object"
    },
    "EvaluationDatasetManifest": {
      "additionalProperties": false,
      "properties": {
        "blind_execution": {
          "const": true,
          "default": true,
          "title": "Blind Execution",
          "type": "boolean"
        },
        "case_count": {
          "maximum": 500,
          "minimum": 1,
          "title": "Case Count",
          "type": "integer"
        },
        "dataset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dataset Sha256",
          "type": "string"
        },
        "dataset_version": {
          "pattern": "^benchmark-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$",
          "title": "Dataset Version",
          "type": "string"
        },
        "parent_dataset_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Dataset Sha256"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/EvaluationUseCaseProfile"
          },
          "title": "Profiles",
          "type": "array"
        },
        "raw_content_retained": {
          "const": false,
          "default": false,
          "title": "Raw Content Retained",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sealed_ground_truth_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sealed Ground Truth Sha256",
          "type": "string"
        },
        "splits": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Splits",
          "type": "object"
        },
        "use_case_count": {
          "maximum": 64,
          "minimum": 1,
          "title": "Use Case Count",
          "type": "integer"
        }
      },
      "required": [
        "dataset_version",
        "case_count",
        "use_case_count",
        "splits",
        "profiles",
        "sealed_ground_truth_sha256",
        "dataset_sha256"
      ],
      "title": "EvaluationDatasetManifest",
      "type": "object"
    },
    "EvaluationDrift": {
      "additionalProperties": false,
      "properties": {
        "baseline_record_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Record Digest",
          "type": "string"
        },
        "candidate_metrics_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Metrics Sha256",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/EvaluationGateCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "metric_deltas": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metric Deltas",
          "type": "object"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "baseline_record_digest",
        "candidate_metrics_sha256",
        "metric_deltas",
        "checks",
        "passed"
      ],
      "title": "EvaluationDrift",
      "type": "object"
    },
    "EvaluationGateCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Check Id",
          "type": "string"
        },
        "observed": {
          "title": "Observed",
          "type": "number"
        },
        "operator": {
          "enum": [
            "gte",
            "lte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "scope": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "check_id",
        "passed",
        "observed",
        "threshold",
        "operator",
        "scope"
      ],
      "title": "EvaluationGateCheck",
      "type": "object"
    },
    "EvaluationGateDecision": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/EvaluationGateCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvaluationDrift"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/EvaluationGateState"
        }
      },
      "required": [
        "state",
        "policy_version",
        "policy_sha256",
        "checks",
        "reasons"
      ],
      "title": "EvaluationGateDecision",
      "type": "object"
    },
    "EvaluationGateState": {
      "enum": [
        "pass",
        "block",
        "hold"
      ],
      "title": "EvaluationGateState",
      "type": "string"
    },
    "EvaluationUseCaseProfile": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "minimum": 1,
          "title": "Cases",
          "type": "integer"
        },
        "framework_mappings": {
          "items": {
            "type": "string"
          },
          "title": "Framework Mappings",
          "type": "array"
        },
        "use_case": {
          "title": "Use Case",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/SimulationVariant"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "use_case",
        "cases",
        "variants",
        "framework_mappings"
      ],
      "title": "EvaluationUseCaseProfile",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SimulationVariant": {
      "enum": [
        "plain",
        "japanese",
        "spanish",
        "unicode_confusable",
        "zero_width",
        "base64",
        "mixed_obfuscation"
      ],
      "title": "SimulationVariant",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/EvaluationCandidateMetadata"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/EvaluationCaseResult"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "dataset": {
      "$ref": "#/$defs/EvaluationDatasetManifest"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "gate": {
      "$ref": "#/$defs/EvaluationGateDecision"
    },
    "metrics": {
      "$ref": "#/$defs/ContinuousEvaluationMetrics"
    },
    "record_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Digest",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split_metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/ContinuousEvaluationMetrics"
      },
      "title": "Split Metrics",
      "type": "object"
    },
    "use_case_metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/ContinuousEvaluationMetrics"
      },
      "title": "Use Case Metrics",
      "type": "object"
    }
  },
  "required": [
    "dataset",
    "candidate",
    "cases",
    "metrics",
    "use_case_metrics",
    "split_metrics",
    "gate",
    "evaluated_at",
    "record_digest"
  ],
  "title": "ContinuousEvaluationReport",
  "type": "object"
}
