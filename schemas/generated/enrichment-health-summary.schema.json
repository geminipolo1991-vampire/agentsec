{
  "$defs": {
    "CircuitState": {
      "enum": [
        "closed",
        "open"
      ],
      "title": "CircuitState",
      "type": "string"
    },
    "ConnectorOutcome": {
      "enum": [
        "success",
        "cache_fresh",
        "cache_stale",
        "policy_denied",
        "circuit_open",
        "timeout",
        "failed"
      ],
      "title": "ConnectorOutcome",
      "type": "string"
    },
    "EnrichmentConnectorHealth": {
      "additionalProperties": false,
      "properties": {
        "cache_entries": {
          "minimum": 0,
          "title": "Cache Entries",
          "type": "integer"
        },
        "cache_hits": {
          "minimum": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "circuit_open_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Circuit Open Until"
        },
        "circuit_state": {
          "$ref": "#/$defs/CircuitState"
        },
        "connector": {
          "title": "Connector",
          "type": "string"
        },
        "connector_version": {
          "title": "Connector Version",
          "type": "string"
        },
        "consecutive_failures": {
          "minimum": 0,
          "title": "Consecutive Failures",
          "type": "integer"
        },
        "failures": {
          "minimum": 0,
          "title": "Failures",
          "type": "integer"
        },
        "last_called_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Called At"
        },
        "last_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Latency Ms"
        },
        "last_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectorOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stale_fallbacks": {
          "minimum": 0,
          "title": "Stale Fallbacks",
          "type": "integer"
        },
        "successes": {
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "timeouts": {
          "minimum": 0,
          "title": "Timeouts",
          "type": "integer"
        }
      },
      "required": [
        "tenant_id",
        "connector",
        "connector_version",
        "circuit_state",
        "successes",
        "failures",
        "timeouts",
        "cache_hits",
        "stale_fallbacks",
        "consecutive_failures",
        "cache_entries"
      ],
      "title": "EnrichmentConnectorHealth",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cache_entries": {
      "minimum": 0,
      "title": "Cache Entries",
      "type": "integer"
    },
    "calculated_at": {
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    },
    "connector_count": {
      "minimum": 0,
      "title": "Connector Count",
      "type": "integer"
    },
    "connectors": {
      "items": {
        "$ref": "#/$defs/EnrichmentConnectorHealth"
      },
      "title": "Connectors",
      "type": "array"
    },
    "healthy_connectors": {
      "minimum": 0,
      "title": "Healthy Connectors",
      "type": "integer"
    },
    "open_circuits": {
      "minimum": 0,
      "title": "Open Circuits",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "connector_count",
    "healthy_connectors",
    "open_circuits",
    "cache_entries",
    "calculated_at"
  ],
  "title": "EnrichmentHealthSummary",
  "type": "object"
}
