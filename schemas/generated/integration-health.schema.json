{
  "$defs": {
    "IntegrationDestinationStatus": {
      "additionalProperties": false,
      "properties": {
        "ack_pending": {
          "minimum": 0,
          "title": "Ack Pending",
          "type": "integer"
        },
        "credential_configured": {
          "title": "Credential Configured",
          "type": "boolean"
        },
        "credential_required": {
          "title": "Credential Required",
          "type": "boolean"
        },
        "dead_letter": {
          "minimum": 0,
          "title": "Dead Letter",
          "type": "integer"
        },
        "delivered": {
          "minimum": 0,
          "title": "Delivered",
          "type": "integer"
        },
        "destination_id": {
          "title": "Destination Id",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "indexer_ack": {
          "title": "Indexer Ack",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/IntegrationKind"
        },
        "last_error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error Code"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "queued": {
          "minimum": 0,
          "title": "Queued",
          "type": "integer"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        }
      },
      "required": [
        "destination_id",
        "name",
        "kind",
        "enabled",
        "ready",
        "credential_required",
        "credential_configured",
        "indexer_ack",
        "queued",
        "ack_pending",
        "delivered",
        "dead_letter"
      ],
      "title": "IntegrationDestinationStatus",
      "type": "object"
    },
    "IntegrationKind": {
      "enum": [
        "splunk_hec",
        "elastic_bulk",
        "signed_webhook",
        "syslog_tls",
        "cef_tls",
        "otlp_http_json"
      ],
      "title": "IntegrationKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ack_pending": {
      "minimum": 0,
      "title": "Ack Pending",
      "type": "integer"
    },
    "calculated_at": {
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    },
    "dead_letter": {
      "minimum": 0,
      "title": "Dead Letter",
      "type": "integer"
    },
    "delivered": {
      "minimum": 0,
      "title": "Delivered",
      "type": "integer"
    },
    "destinations": {
      "items": {
        "$ref": "#/$defs/IntegrationDestinationStatus"
      },
      "maxItems": 32,
      "title": "Destinations",
      "type": "array"
    },
    "events": {
      "minimum": 0,
      "title": "Events",
      "type": "integer"
    },
    "pipeline_enqueue_error": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pipeline Enqueue Error"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "queued": {
      "minimum": 0,
      "title": "Queued",
      "type": "integer"
    },
    "retrying": {
      "minimum": 0,
      "title": "Retrying",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "pattern": "^(healthy|degraded|not_ready)$",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "policy_version",
    "events",
    "queued",
    "retrying",
    "ack_pending",
    "delivered",
    "dead_letter",
    "destinations"
  ],
  "title": "IntegrationHealth",
  "type": "object"
}
