{
  "$defs": {
    "DecisionAction": {
      "enum": [
        "allow",
        "allow_with_obligations",
        "require_approval",
        "deny"
      ],
      "title": "DecisionAction",
      "type": "string"
    },
    "DetectionCondition": {
      "additionalProperties": false,
      "properties": {
        "compare_field": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetectionEventField"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field": {
          "$ref": "#/$defs/DetectionEventField"
        },
        "operator": {
          "$ref": "#/$defs/DetectionOperator"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator"
      ],
      "title": "DetectionCondition",
      "type": "object"
    },
    "DetectionEventField": {
      "enum": [
        "event_id",
        "flow_id",
        "agent_id",
        "operation",
        "resource",
        "destination",
        "source_type",
        "source_id",
        "source_trust",
        "data_classes",
        "authority_operations",
        "indicators",
        "approval_present",
        "is_effectful",
        "tool_name",
        "declared_tool_schema_digest",
        "observed_tool_schema_digest"
      ],
      "title": "DetectionEventField",
      "type": "string"
    },
    "DetectionExecutionMode": {
      "enum": [
        "streaming",
        "scheduled",
        "both"
      ],
      "title": "DetectionExecutionMode",
      "type": "string"
    },
    "DetectionOperator": {
      "enum": [
        "equals",
        "not_equals",
        "in",
        "not_in",
        "contains",
        "not_contains",
        "exists",
        "not_exists",
        "equals_field",
        "not_equals_field",
        "contains_field",
        "not_contains_field"
      ],
      "title": "DetectionOperator",
      "type": "string"
    },
    "DetectionPredicate": {
      "additionalProperties": false,
      "properties": {
        "all_conditions": {
          "items": {
            "$ref": "#/$defs/DetectionCondition"
          },
          "maxItems": 32,
          "title": "All Conditions",
          "type": "array"
        },
        "any_conditions": {
          "items": {
            "$ref": "#/$defs/DetectionCondition"
          },
          "maxItems": 32,
          "title": "Any Conditions",
          "type": "array"
        }
      },
      "title": "DetectionPredicate",
      "type": "object"
    },
    "DetectionRuleDefinition": {
      "additionalProperties": false,
      "properties": {
        "alert_type": {
          "pattern": "^[a-z][a-z0-9_]{2,127}$",
          "title": "Alert Type",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "correlation_predicates": {
          "items": {
            "$ref": "#/$defs/DetectionPredicate"
          },
          "maxItems": 10,
          "title": "Correlation Predicates",
          "type": "array"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 3,
          "title": "Description",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "evidence_fields": {
          "items": {
            "$ref": "#/$defs/DetectionEventField"
          },
          "maxItems": 16,
          "title": "Evidence Fields",
          "type": "array"
        },
        "execution_mode": {
          "$ref": "#/$defs/DetectionExecutionMode"
        },
        "framework_mappings": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Framework Mappings",
          "type": "array"
        },
        "group_by": {
          "$ref": "#/$defs/DetectionEventField",
          "default": "flow_id"
        },
        "kind": {
          "$ref": "#/$defs/DetectionRuleKind"
        },
        "name": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/DetectionPredicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "recommended_action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "rule_id": {
          "pattern": "^DET-[A-Z0-9-]{3,80}$",
          "title": "Rule Id",
          "type": "string"
        },
        "semantic_min_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Min Confidence"
        },
        "semantic_profile": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Profile"
        },
        "sequence_steps": {
          "items": {
            "$ref": "#/$defs/DetectionPredicate"
          },
          "maxItems": 10,
          "title": "Sequence Steps",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Tags",
          "type": "array"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "title": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Version",
          "type": "string"
        },
        "window_seconds": {
          "anyOf": [
            {
              "maximum": 604800,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Seconds"
        }
      },
      "required": [
        "rule_id",
        "version",
        "name",
        "description",
        "kind",
        "execution_mode",
        "alert_type",
        "title",
        "severity",
        "confidence",
        "recommended_action",
        "reason_codes",
        "framework_mappings"
      ],
      "title": "DetectionRuleDefinition",
      "type": "object"
    },
    "DetectionRuleKind": {
      "enum": [
        "event",
        "sequence",
        "threshold",
        "correlation",
        "semantic"
      ],
      "title": "DetectionRuleKind",
      "type": "string"
    },
    "RuleBacktestResult": {
      "additionalProperties": false,
      "properties": {
        "alert_count": {
          "minimum": 0,
          "title": "Alert Count",
          "type": "integer"
        },
        "alert_types": {
          "items": {
            "type": "string"
          },
          "title": "Alert Types",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "definition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Definition Sha256",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "event_count": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Event Count",
          "type": "integer"
        },
        "match_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Match Rate",
          "type": "number"
        },
        "matched_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Matched Event Ids",
          "type": "array"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "definition_sha256",
        "event_count",
        "alert_count",
        "matched_event_ids",
        "alert_types",
        "errors",
        "match_rate",
        "result_sha256",
        "duration_ms",
        "completed_at"
      ],
      "title": "RuleBacktestResult",
      "type": "object"
    },
    "RuleContentStatus": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "rejected",
        "shadow",
        "published",
        "retired"
      ],
      "title": "RuleContentStatus",
      "type": "string"
    },
    "RuleValidationResult": {
      "additionalProperties": false,
      "properties": {
        "actual_alert_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Actual Alert Event Ids",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "definition_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Definition Sha256",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "event_count": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Event Count",
          "type": "integer"
        },
        "expected_alert_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Expected Alert Event Ids",
          "type": "array"
        },
        "false_negative_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "False Negative Event Ids",
          "type": "array"
        },
        "false_positive_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "False Positive Event Ids",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "suite_name": {
          "title": "Suite Name",
          "type": "string"
        }
      },
      "required": [
        "suite_name",
        "definition_sha256",
        "event_count",
        "expected_alert_event_ids",
        "actual_alert_event_ids",
        "false_positive_event_ids",
        "false_negative_event_ids",
        "errors",
        "passed",
        "duration_ms",
        "completed_at"
      ],
      "title": "RuleValidationResult",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "author_id": {
      "title": "Author Id",
      "type": "string"
    },
    "backtest": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleBacktestResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_id": {
      "pattern": "^drc_[A-Za-z0-9]+$",
      "title": "Content Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/DetectionRuleDefinition"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "retired_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retired At"
    },
    "review_comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Comment"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "reviewer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Id"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "shadow_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleBacktestResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shadowed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shadowed At"
    },
    "signature": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Signature",
      "type": "string"
    },
    "signature_algorithm": {
      "title": "Signature Algorithm",
      "type": "string"
    },
    "source_pack_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Pack Id"
    },
    "status": {
      "$ref": "#/$defs/RuleContentStatus"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleValidationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "content_id",
    "tenant_id",
    "revision",
    "status",
    "definition",
    "author_id",
    "created_at",
    "updated_at",
    "record_sha256",
    "signature_algorithm",
    "signature"
  ],
  "title": "RuleContentRecord",
  "type": "object"
}
