{
  "$defs": {
    "DeliveryState": {
      "enum": [
        "pending",
        "partial",
        "delivered",
        "dead_letter"
      ],
      "title": "DeliveryState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Action",
      "type": "string"
    },
    "actor_id": {
      "pattern": "^(analyst|system|workload)://[A-Za-z0-9_.@/-]+$",
      "title": "Actor Id",
      "type": "string"
    },
    "audit_id": {
      "pattern": "^nau_[0-9a-f]{32}$",
      "title": "Audit Id",
      "type": "string"
    },
    "audit_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Audit Sha256",
      "type": "string"
    },
    "delivery_state_after": {
      "$ref": "#/$defs/DeliveryState"
    },
    "delivery_state_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliveryState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "detail_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Detail Sha256",
      "type": "string"
    },
    "notification_id": {
      "pattern": "^ntf_[0-9a-f]{32}$",
      "title": "Notification Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "previous_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Sha256",
      "type": "string"
    },
    "sequence": {
      "maximum": 2000,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "notification_id",
    "tenant_id",
    "sequence",
    "actor_id",
    "action",
    "delivery_state_after",
    "detail_sha256",
    "occurred_at",
    "previous_sha256",
    "audit_sha256"
  ],
  "title": "NotificationAuditEntry",
  "type": "object"
}
