{
  "$defs": {
    "CaseRelationshipKind": {
      "enum": [
        "related",
        "parent",
        "child",
        "duplicate",
        "blocks"
      ],
      "title": "CaseRelationshipKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_version": {
      "minimum": 1,
      "title": "Expected Version",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/CaseRelationshipKind"
    },
    "reason": {
      "default": "Evidence-backed analyst relationship.",
      "maxLength": 512,
      "minLength": 10,
      "title": "Reason",
      "type": "string"
    },
    "target_id": {
      "maxLength": 128,
      "minLength": 5,
      "title": "Target Id",
      "type": "string"
    },
    "target_type": {
      "pattern": "^(case|finding|incident)$",
      "title": "Target Type",
      "type": "string"
    }
  },
  "required": [
    "expected_version",
    "kind",
    "target_type",
    "target_id"
  ],
  "title": "CaseRelationshipRequest",
  "type": "object"
}
