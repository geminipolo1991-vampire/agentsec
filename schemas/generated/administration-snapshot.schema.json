          "minimum": 0,
          "title": "Identities",
          "type": "integer"
        },
        "latest_recovery_drill_passed": {
          "title": "Latest Recovery Drill Passed",
          "type": "boolean"
        },
        "latest_slos_passed": {
          "title": "Latest Slos Passed",
          "type": "boolean"
        },
        "latest_supply_chain_attestation_passed": {
          "title": "Latest Supply Chain Attestation Passed",
          "type": "boolean"
        },
        "legal_hold": {
          "title": "Legal Hold",
          "type": "boolean"
        },
        "local_identity_adapter": {
          "const": true,
          "default": true,
          "title": "Local Identity Adapter",
          "type": "boolean"
        },
        "production_ready": {
          "const": false,
          "default": false,
          "title": "Production Ready",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "pattern": "^(healthy|attention_required)$",
          "title": "Status",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "workloads": {
          "minimum": 0,
          "title": "Workloads",
          "type": "integer"
        }
      },
      "required": [
        "tenant_id",
        "status",
        "identities",
        "workloads",
        "active_keys",
        "access_reviews",
        "audit_entries",
        "audit_valid",
        "latest_slos_passed",
        "latest_recovery_drill_passed",
        "latest_supply_chain_attestation_passed",
        "legal_hold",
        "boundaries",
        "calculated_at"
      ],
      "title": "AdministrationHealth",
      "type": "object"
    },
    "HumanIdentityRecord": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 2,
          "title": "Display Name",
          "type": "string"
        },
        "email_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Email Sha256",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "granted_by": {
          "title": "Granted By",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/HumanRole"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Roles",
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "pattern": "^analyst://[A-Za-z0-9_.@/-]+$",
          "title": "Subject",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "tenant_id",
        "subject",
        "display_name",
        "email_sha256",
        "roles",
        "enabled",
        "granted_by",
        "created_at",
        "updated_at",
        "version",
        "record_sha256"
      ],
      "title": "HumanIdentityRecord",
      "type": "object"
    },
    "HumanRole": {
      "enum": [
        "viewer",
        "analyst",
        "incident_commander",
        "policy_owner",
        "platform_administrator",
        "security_auditor"
      ],
