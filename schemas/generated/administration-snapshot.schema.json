        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "key_id": {
          "pattern": "^managed-key://[A-Za-z0-9_.@/-]+$",
          "title": "Key Id",
          "type": "string"
        },
        "previous_key_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
