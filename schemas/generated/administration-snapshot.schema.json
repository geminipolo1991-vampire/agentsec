      "type": "string"
    },
    "KeyState": {
      "enum": [
        "pending",
        "active",
        "retired",
        "revoked"
      ],
      "title": "KeyState",
      "type": "string"
    },
    "ManagedKeyRecord": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
