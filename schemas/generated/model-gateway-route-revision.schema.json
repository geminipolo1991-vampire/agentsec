{
  "$defs": {
    "AiMode": {
      "enum": [
        "off",
        "shadow",
        "advisory",
        "semantic_hold"
      ],
      "title": "AiMode",
      "type": "string"
    },
    "DataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "ProviderKind": {
      "enum": [
        "openai",
        "anthropic"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "RouteStage": {
      "enum": [
        "candidate",
        "shadow",
        "active",
        "retired"
      ],
      "title": "RouteStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activated At"
    },
    "allowed_data_classes": {
      "items": {
        "$ref": "#/$defs/DataClassification"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Allowed Data Classes",
      "type": "array",
      "uniqueItems": true
    },
    "allowed_modes": {
      "items": {
        "$ref": "#/$defs/AiMode"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Allowed Modes",
      "type": "array",
      "uniqueItems": true
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "endpoint": {
      "maxLength": 512,
      "minLength": 8,
      "title": "Endpoint",
      "type": "string"
    },
    "exact_model_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Exact Model Id",
      "type": "string"
    },
    "fallback_route_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Route Id"
    },
    "max_concurrency": {
      "default": 4,
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Concurrency",
      "type": "integer"
    },
    "max_output_tokens": {
      "default": 512,
      "maximum": 100000,
      "minimum": 32,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "max_requests_per_minute": {
      "default": 60,
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Requests Per Minute",
      "type": "integer"
    },
    "max_tokens_per_day": {
      "default": 100000,
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Max Tokens Per Day",
      "type": "integer"
    },
    "priority": {
      "default": 100,
      "maximum": 10000,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "prompt_id": {
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_version": {
      "minimum": 1,
      "title": "Prompt Version",
      "type": "integer"
    },
    "provider": {
      "$ref": "#/$defs/ProviderKind"
    },
    "region": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Region",
      "type": "string"
    },
    "retired_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retired At"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "route_id": {
      "pattern": "^mrt_[A-Za-z0-9_.-]+$",
      "title": "Route Id",
      "type": "string"
    },
    "route_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Route Sha256",
      "type": "string"
    },
    "secret_id": {
      "title": "Secret Id",
      "type": "string"
    },
    "secret_version": {
      "minimum": 1,
      "title": "Secret Version",
      "type": "integer"
    },
    "stage": {
      "$ref": "#/$defs/RouteStage",
      "default": "candidate"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 30.0,
      "maximum": 300.0,
      "minimum": 1.0,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "workload": {
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "title": "Workload",
      "type": "string"
    }
  },
  "required": [
    "route_id",
    "revision",
    "tenant_id",
    "provider",
    "exact_model_id",
    "endpoint",
    "secret_id",
    "secret_version",
    "prompt_id",
    "prompt_version",
    "workload",
    "allowed_modes",
    "allowed_data_classes",
    "region",
    "created_by",
    "created_at",
    "route_sha256"
  ],
  "title": "ModelRouteRevision",
  "type": "object"
}
