{
  "$defs": {
    "AiMode": {
      "enum": [
        "off",
        "shadow",
        "advisory",
        "semantic_hold"
      ],
      "title": "AiMode",
      "type": "string"
    },
    "DataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "ProviderKind": {
      "enum": [
        "openai",
        "anthropic"
      ],
      "title": "ProviderKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_data_classes": {
      "items": {
        "$ref": "#/$defs/DataClassification"
      },
      "title": "Allowed Data Classes",
      "type": "array",
      "uniqueItems": true
    },
    "allowed_modes": {
      "items": {
        "$ref": "#/$defs/AiMode"
      },
      "title": "Allowed Modes",
      "type": "array",
      "uniqueItems": true
    },
    "endpoint": {
      "title": "Endpoint",
      "type": "string"
    },
    "exact_model_id": {
      "title": "Exact Model Id",
      "type": "string"
    },
    "fallback_route_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Route Id"
    },
    "max_concurrency": {
      "default": 4,
      "title": "Max Concurrency",
      "type": "integer"
    },
    "max_output_tokens": {
      "default": 512,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "max_requests_per_minute": {
      "default": 60,
      "title": "Max Requests Per Minute",
      "type": "integer"
    },
    "max_tokens_per_day": {
      "default": 100000,
      "title": "Max Tokens Per Day",
      "type": "integer"
    },
    "priority": {
      "default": 100,
      "title": "Priority",
      "type": "integer"
    },
    "prompt_id": {
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_version": {
      "default": 1,
      "title": "Prompt Version",
      "type": "integer"
    },
    "provider": {
      "$ref": "#/$defs/ProviderKind"
    },
    "region": {
      "title": "Region",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "title": "Revision",
      "type": "integer"
    },
    "route_id": {
      "title": "Route Id",
      "type": "string"
    },
    "secret_id": {
      "title": "Secret Id",
      "type": "string"
    },
    "secret_version": {
      "default": 1,
      "title": "Secret Version",
      "type": "integer"
    },
    "timeout_seconds": {
      "default": 30.0,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "workload": {
      "title": "Workload",
      "type": "string"
    }
  },
  "required": [
    "route_id",
    "provider",
    "exact_model_id",
    "endpoint",
    "secret_id",
    "prompt_id",
    "workload",
    "allowed_modes",
    "allowed_data_classes",
    "region"
  ],
  "title": "RouteConfiguration",
  "type": "object"
}
