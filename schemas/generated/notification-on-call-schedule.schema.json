      "pattern": "^schedule://[A-Za-z0-9_.@/-]+$",
      "title": "Schedule Id",
      "type": "string"
    },
    "starts_at": {
      "format": "date-time",
      "title": "Starts At",
      "type": "string"
    },
    "timezone_name": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Timezone Name",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "schedule_id",
    "name",
    "timezone_name",
    "starts_at",
    "rotation_minutes",
    "member_ids",
    "version"
