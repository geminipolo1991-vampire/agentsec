{
  "additionalProperties": false,
  "properties": {
    "member_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Member Ids",
      "type": "array"
    },
    "name": {
      "maxLength": 128,
      "minLength": 3,
      "title": "Name",
      "type": "string"
    },
    "rotation_minutes": {
      "maximum": 10080,
      "minimum": 15,
      "title": "Rotation Minutes",
      "type": "integer"
    },
