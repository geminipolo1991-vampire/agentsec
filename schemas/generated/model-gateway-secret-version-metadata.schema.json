{
  "$defs": {
    "SecretStage": {
      "enum": [
        "active",
        "retired"
      ],
      "title": "SecretStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "environment_variable": {
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
      "title": "Environment Variable",
      "type": "string"
    },
    "retired_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retired At"
    },
    "secret_id": {
      "pattern": "^sec_[A-Za-z0-9_.-]+$",
      "title": "Secret Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/SecretStage"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "value_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Value Sha256",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "secret_id",
    "version",
    "tenant_id",
    "environment_variable",
    "value_sha256",
    "stage",
    "created_by",
    "created_at"
  ],
  "title": "SecretVersionMetadata",
  "type": "object"
}
