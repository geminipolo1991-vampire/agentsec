{
  "$defs": {
    "HumanRole": {
      "enum": [
        "viewer",
        "analyst",
        "incident_commander",
        "policy_owner",
        "platform_administrator",
        "security_auditor"
      ],
      "title": "HumanRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "display_name": {
      "maxLength": 128,
      "minLength": 2,
      "title": "Display Name",
      "type": "string"
    },
    "email_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Email Sha256",
      "type": "string"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "granted_by": {
      "title": "Granted By",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/HumanRole"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Roles",
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "pattern": "^analyst://[A-Za-z0-9_.@/-]+$",
      "title": "Subject",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "tenant_id",
    "subject",
    "display_name",
    "email_sha256",
    "roles",
    "enabled",
    "granted_by",
    "created_at",
    "updated_at",
    "version",
    "record_sha256"
  ],
  "title": "HumanIdentityRecord",
  "type": "object"
}
