{
  "$defs": {
    "HumanRole": {
      "enum": [
        "viewer",
        "analyst",
        "incident_commander",
        "policy_owner",
        "platform_administrator",
        "security_auditor"
      ],
      "title": "HumanRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "pattern": "^(certified|revoke_required)$",
      "title": "Decision",
      "type": "string"
    },
    "rationale_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rationale Sha256",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "review_id": {
      "pattern": "^access-review_[0-9a-f]{32}$",
      "title": "Review Id",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer_id": {
      "title": "Reviewer Id",
      "type": "string"
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/HumanRole"
      },
      "title": "Roles",
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "tenant_id",
    "subject",
    "roles",
    "decision",
    "rationale_sha256",
    "reviewer_id",
    "reviewed_at",
    "record_sha256"
  ],
  "title": "AccessReviewRecord",
  "type": "object"
}
