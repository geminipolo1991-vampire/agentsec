    "credential_configured": {
      "title": "Credential Configured",
      "type": "boolean"
    },
    "credential_required": {
      "title": "Credential Required",
      "type": "boolean"
    },
    "dead_letter": {
      "minimum": 0,
      "title": "Dead Letter",
      "type": "integer"
    },
    "delivered": {
      "minimum": 0,
      "title": "Delivered",
      "type": "integer"
    },
    "destination_id": {
      "title": "Destination Id",
      "type": "string"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "indexer_ack": {
      "title": "Indexer Ack",
      "type": "boolean"
