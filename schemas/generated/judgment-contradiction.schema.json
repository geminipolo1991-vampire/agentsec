{
  "additionalProperties": false,
  "properties": {
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Evidence Ids",
      "type": "array"
    },
    "fact_key": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "title": "Fact Key",
      "type": "string"
    },
    "left_claim_id": {
      "pattern": "^acm_[0-9a-f]{32}$",
      "title": "Left Claim Id",
      "type": "string"
    },
    "reason_code": {
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
      "title": "Reason Code",
      "type": "string"
    },
    "right_claim_id": {
      "pattern": "^acm_[0-9a-f]{32}$",
      "title": "Right Claim Id",
      "type": "string"
    },
    "subject": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    }
  },
  "required": [
    "left_claim_id",
    "right_claim_id",
    "subject",
    "fact_key",
    "reason_code"
  ],
  "title": "JudgmentContradiction",
  "type": "object"
}
