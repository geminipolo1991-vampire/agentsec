{
  "$defs": {
    "GatewayEventStatus": {
      "enum": [
        "accepted",
        "duplicate",
        "processing",
        "rejected",
        "conflict",
        "backpressure"
      ],
      "title": "GatewayEventStatus",
      "type": "string"
    },
    "GatewayReceipt": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "queue_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Id"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_health": {
          "$ref": "#/$defs/GatewaySourceHealth"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GatewayEventStatus"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "tenant_id",
        "source_id",
        "source_health"
      ],
      "title": "GatewayReceipt",
      "type": "object"
    },
    "GatewaySourceHealth": {
      "additionalProperties": false,
      "properties": {
        "accepted_events": {
          "minimum": 0,
          "title": "Accepted Events",
          "type": "integer"
        },
        "backpressured_events": {
          "minimum": 0,
          "title": "Backpressured Events",
          "type": "integer"
        },
        "dead_letter_events": {
          "minimum": 0,
          "title": "Dead Letter Events",
          "type": "integer"
        },
        "duplicate_events": {
          "minimum": 0,
          "title": "Duplicate Events",
          "type": "integer"
        },
        "last_error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error Code"
        },
        "last_processed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Processed At"
        },
        "last_received_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Received At"
        },
        "pending_events": {
          "minimum": 0,
          "title": "Pending Events",
          "type": "integer"
        },
        "processed_events": {
          "minimum": 0,
          "title": "Processed Events",
          "type": "integer"
        },
        "processing_events": {
          "minimum": 0,
          "title": "Processing Events",
          "type": "integer"
        },
        "rate_limited_requests": {
          "minimum": 0,
          "title": "Rate Limited Requests",
          "type": "integer"
        },
        "rejected_events": {
          "minimum": 0,
          "title": "Rejected Events",
          "type": "integer"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tenant_id": {
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "source_id",
        "status",
        "accepted_events",
        "duplicate_events",
        "rejected_events",
        "rate_limited_requests",
        "backpressured_events",
        "processed_events",
        "dead_letter_events",
        "pending_events",
        "processing_events"
      ],
      "title": "GatewaySourceHealth",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "minimum": 0,
      "title": "Accepted",
      "type": "integer"
    },
    "backpressured": {
      "minimum": 0,
      "title": "Backpressured",
      "type": "integer"
    },
    "conflicts": {
      "minimum": 0,
      "title": "Conflicts",
      "type": "integer"
    },
    "duplicates": {
      "minimum": 0,
      "title": "Duplicates",
      "type": "integer"
    },
    "processing": {
      "minimum": 0,
      "title": "Processing",
      "type": "integer"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/GatewayReceipt"
      },
      "title": "Receipts",
      "type": "array"
    },
    "rejected": {
      "minimum": 0,
      "title": "Rejected",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "accepted",
    "duplicates",
    "processing",
    "rejected",
    "conflicts",
    "backpressured"
  ],
  "title": "GatewayBatchResponse",
  "type": "object"
}
