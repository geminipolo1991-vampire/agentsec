{
  "$defs": {
    "BaselineState": {
      "enum": [
        "learning",
        "active"
      ],
      "title": "BaselineState",
      "type": "string"
    },
    "BehaviorEntityType": {
      "enum": [
        "agent",
        "source",
        "tool",
        "destination"
      ],
      "title": "BehaviorEntityType",
      "type": "string"
    },
    "BehaviorRiskFactor": {
      "additionalProperties": false,
      "properties": {
        "contribution": {
          "maximum": 100,
          "minimum": 0,
          "title": "Contribution",
          "type": "integer"
        },
        "entity_ref": {
          "maxLength": 128,
          "minLength": 8,
          "title": "Entity Ref",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "factor": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Factor",
          "type": "string"
        },
        "observed": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Observed",
          "type": "string"
        },
        "probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Probability",
          "type": "number"
        },
        "rationale": {
          "maxLength": 512,
          "minLength": 3,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "factor",
        "entity_ref",
        "observed",
        "expected",
        "probability",
        "contribution",
        "evidence_refs",
        "rationale"
      ],
      "title": "BehaviorRiskFactor",
      "type": "object"
    },
    "DriftState": {
      "enum": [
        "insufficient_data",
        "stable",
        "warning",
        "critical"
      ],
      "title": "DriftState",
      "type": "string"
    },
    "EntityBehaviorScore": {
      "additionalProperties": false,
      "properties": {
        "anomaly_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Anomaly Score",
          "type": "integer"
        },
        "baseline_revision": {
          "minimum": 0,
          "title": "Baseline Revision",
          "type": "integer"
        },
        "baseline_state": {
          "$ref": "#/$defs/BaselineState"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "entity_ref": {
          "title": "Entity Ref",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/BehaviorEntityType"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/BehaviorRiskFactor"
          },
          "maxItems": 32,
          "title": "Factors",
          "type": "array"
        },
        "observation_count": {
          "minimum": 0,
          "title": "Observation Count",
          "type": "integer"
        }
      },
      "required": [
        "entity_ref",
        "entity_type",
        "baseline_revision",
        "observation_count",
        "baseline_state",
        "anomaly_score",
        "confidence",
        "evaluated_at"
      ],
      "title": "EntityBehaviorScore",
      "type": "object"
    },
    "LearningStatus": {
      "enum": [
        "pending",
        "learned",
        "rejected"
      ],
      "title": "LearningStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anomaly_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Anomaly Score",
      "type": "integer"
    },
    "assessment_id": {
      "pattern": "^bhas_[A-Za-z0-9]+$",
      "title": "Assessment Id",
      "type": "string"
    },
    "cold_start": {
      "title": "Cold Start",
      "type": "boolean"
    },
    "composite_risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Composite Risk Score",
      "type": "integer"
    },
    "config_id": {
      "title": "Config Id",
      "type": "string"
    },
    "config_version": {
      "title": "Config Version",
      "type": "string"
    },
    "drift_state": {
      "$ref": "#/$defs/DriftState"
    },
    "entity_scores": {
      "items": {
        "$ref": "#/$defs/EntityBehaviorScore"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Entity Scores",
      "type": "array"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "factors": {
      "items": {
        "$ref": "#/$defs/BehaviorRiskFactor"
      },
      "maxItems": 64,
      "title": "Factors",
      "type": "array"
    },
    "feature_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Sha256",
      "type": "string"
    },
    "is_anomaly": {
      "title": "Is Anomaly",
      "type": "boolean"
    },
    "learning_reason": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Learning Reason"
    },
    "learning_status": {
      "$ref": "#/$defs/LearningStatus",
      "default": "pending"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "tenant_id",
    "event_id",
    "feature_sha256",
    "config_id",
    "config_version",
    "entity_scores",
    "anomaly_score",
    "composite_risk_score",
    "is_anomaly",
    "cold_start",
    "drift_state",
    "evaluated_at"
  ],
  "title": "BehaviorEventAssessment",
  "type": "object"
}
