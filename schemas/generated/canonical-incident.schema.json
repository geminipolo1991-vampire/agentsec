{
  "$defs": {
    "IncidentStatus": {
      "enum": [
        "open",
        "acknowledged",
        "investigating",
        "contained",
        "resolved",
        "closed"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "entity_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Entity Ids",
      "type": "array"
    },
    "finding_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Finding Ids",
      "type": "array"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 5,
      "title": "Incident Id",
      "type": "string"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Labels",
      "type": "array",
      "uniqueItems": true
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "owner_ref": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Ref"
    },
    "record_type": {
      "const": "incident",
      "default": "incident",
      "title": "Record Type",
      "type": "string"
    },
    "risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Score",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus",
      "default": "open"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "incident_id",
    "title",
    "finding_ids",
    "entity_ids",
    "severity",
    "risk_score"
  ],
  "title": "IncidentRecord",
  "type": "object"
}
