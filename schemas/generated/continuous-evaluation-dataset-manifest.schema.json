{
  "$defs": {
    "EvaluationUseCaseProfile": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "minimum": 1,
          "title": "Cases",
          "type": "integer"
        },
        "framework_mappings": {
          "items": {
            "type": "string"
          },
          "title": "Framework Mappings",
          "type": "array"
        },
        "use_case": {
          "title": "Use Case",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/SimulationVariant"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "use_case",
        "cases",
        "variants",
        "framework_mappings"
      ],
      "title": "EvaluationUseCaseProfile",
      "type": "object"
    },
    "SimulationVariant": {
      "enum": [
        "plain",
        "japanese",
        "spanish",
        "unicode_confusable",
        "zero_width",
        "base64",
        "mixed_obfuscation"
      ],
      "title": "SimulationVariant",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blind_execution": {
      "const": true,
      "default": true,
      "title": "Blind Execution",
      "type": "boolean"
    },
    "case_count": {
      "maximum": 500,
      "minimum": 1,
      "title": "Case Count",
      "type": "integer"
    },
    "dataset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "dataset_version": {
      "pattern": "^benchmark-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$",
      "title": "Dataset Version",
      "type": "string"
    },
    "parent_dataset_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Dataset Sha256"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/EvaluationUseCaseProfile"
      },
      "title": "Profiles",
      "type": "array"
    },
    "raw_content_retained": {
      "const": false,
      "default": false,
      "title": "Raw Content Retained",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sealed_ground_truth_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sealed Ground Truth Sha256",
      "type": "string"
    },
    "splits": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Splits",
      "type": "object"
    },
    "use_case_count": {
      "maximum": 64,
      "minimum": 1,
      "title": "Use Case Count",
      "type": "integer"
    }
  },
  "required": [
    "dataset_version",
    "case_count",
    "use_case_count",
    "splits",
    "profiles",
    "sealed_ground_truth_sha256",
    "dataset_sha256"
  ],
  "title": "EvaluationDatasetManifest",
  "type": "object"
}
