{
  "$defs": {
    "AnalystFeedbackRating": {
      "enum": [
        "helpful",
        "incorrect",
        "incomplete",
        "needs_review"
      ],
      "title": "AnalystFeedbackRating",
      "type": "string"
    },
    "AnalystRole": {
      "enum": [
        "triage",
        "investigation",
        "judge",
        "escalation",
        "response_advisor"
      ],
      "title": "AnalystRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 256,
      "minLength": 3,
      "title": "Actor Id",
      "type": "string"
    },
    "applied_to_model": {
      "const": false,
      "default": false,
      "title": "Applied To Model",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "feedback_id": {
      "title": "Feedback Id",
      "type": "string"
    },
    "feedback_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feedback Sha256",
      "type": "string"
    },
    "rating": {
      "$ref": "#/$defs/AnalystFeedbackRating"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Reason",
      "type": "string"
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalystRole"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "pattern": "^air_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "run_id",
    "actor_id",
    "rating",
    "reason",
    "feedback_sha256"
  ],
  "title": "AnalystFeedback",
  "type": "object"
}
