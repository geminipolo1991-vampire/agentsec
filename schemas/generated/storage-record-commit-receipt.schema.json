{
  "$defs": {
    "RecordType": {
      "enum": [
        "event",
        "evidence",
        "entity",
        "alert",
        "finding",
        "incident",
        "investigation",
        "judgment",
        "action"
      ],
      "title": "RecordType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "current_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Hash",
      "type": "string"
    },
    "duplicate": {
      "title": "Duplicate",
      "type": "boolean"
    },
    "ledger_sequence": {
      "minimum": 1,
      "title": "Ledger Sequence",
      "type": "integer"
    },
    "previous_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Hash",
      "type": "string"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "record_type": {
      "$ref": "#/$defs/RecordType"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "record_type",
    "record_id",
    "revision",
    "ledger_sequence",
    "record_sha256",
    "previous_hash",
    "current_hash",
    "duplicate",
    "committed_at"
  ],
  "title": "RecordCommitReceipt",
  "type": "object"
}
