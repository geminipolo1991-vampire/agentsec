{
  "$defs": {
    "AiMode": {
      "enum": [
        "off",
        "shadow",
        "advisory",
        "semantic_hold"
      ],
      "title": "AiMode",
      "type": "string"
    },
    "DataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "GatewayCallStatus": {
      "enum": [
        "reserved",
        "completed",
        "failed",
        "denied"
      ],
      "title": "GatewayCallStatus",
      "type": "string"
    },
    "ProviderKind": {
      "enum": [
        "openai",
        "anthropic"
      ],
      "title": "ProviderKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "call_id": {
      "pattern": "^mgc_[0-9a-f]{32}$",
      "title": "Call Id",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_classes": {
      "items": {
        "$ref": "#/$defs/DataClassification"
      },
      "title": "Data Classes",
      "type": "array",
      "uniqueItems": true
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9_]{3,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "exact_model_id": {
      "title": "Exact Model Id",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/AiMode"
    },
    "output_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Sha256"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "prompt_id": {
      "title": "Prompt Id",
      "type": "string"
    },
    "prompt_version": {
      "minimum": 1,
      "title": "Prompt Version",
      "type": "integer"
    },
    "provider": {
      "$ref": "#/$defs/ProviderKind"
    },
    "provider_request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Request Id"
    },
    "reserved_tokens": {
      "minimum": 0,
      "title": "Reserved Tokens",
      "type": "integer"
    },
    "route_id": {
      "title": "Route Id",
      "type": "string"
    },
    "route_revision": {
      "minimum": 1,
      "title": "Route Revision",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/GatewayCallStatus"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "total_tokens": {
      "minimum": 0,
      "title": "Total Tokens",
      "type": "integer"
    },
    "workload": {
      "title": "Workload",
      "type": "string"
    }
  },
  "required": [
    "call_id",
    "tenant_id",
    "route_id",
    "route_revision",
    "provider",
    "exact_model_id",
    "prompt_id",
    "prompt_version",
    "workload",
    "mode",
    "data_classes",
    "status",
    "reserved_tokens",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "latency_ms",
    "created_at"
  ],
  "title": "ModelCallReceipt",
  "type": "object"
}
