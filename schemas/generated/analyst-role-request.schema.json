{
  "$defs": {
    "AnalystEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^[a-z][a-z0-9_-]{1,31}_sha256:[0-9a-f]{24}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "maxProperties": 32,
          "title": "Facts",
          "type": "object"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "source",
        "observed_at"
      ],
      "title": "AnalystEvidenceItem",
      "type": "object"
    },
    "AnalystRole": {
      "enum": [
        "triage",
        "investigation",
        "judge",
        "escalation",
        "response_advisor"
      ],
      "title": "AnalystRole",
      "type": "string"
    },
    "DecisionAction": {
      "enum": [
        "allow",
        "allow_with_obligations",
        "require_approval",
        "deny"
      ],
      "title": "DecisionAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alert_id": {
      "maxLength": 128,
      "minLength": 5,
      "title": "Alert Id",
      "type": "string"
    },
    "deterministic_action": {
      "$ref": "#/$defs/DecisionAction"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/AnalystEvidenceItem"
      },
      "maxItems": 64,
      "title": "Evidence",
      "type": "array"
    },
    "max_alternatives": {
      "default": 3,
      "maximum": 5,
      "minimum": 1,
      "title": "Max Alternatives",
      "type": "integer"
    },
    "objective": {
      "maxLength": 512,
      "minLength": 3,
      "title": "Objective",
      "type": "string"
    },
    "prior_role_summaries": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "title": "Prior Role Summaries",
      "type": "array"
    },
    "priority": {
      "pattern": "^P[0-3]$",
      "title": "Priority",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/AnalystRole"
    },
    "run_id": {
      "pattern": "^air_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "role",
    "alert_id",
    "objective",
    "deterministic_action",
    "priority",
    "requested_at"
  ],
  "title": "AnalystRoleRequest",
  "type": "object"
}
