{
  "$defs": {
    "RecordType": {
      "enum": [
        "event",
        "evidence",
        "entity",
        "alert",
        "finding",
        "incident",
        "investigation",
        "judgment",
        "action"
      ],
      "title": "RecordType",
      "type": "string"
    },
    "SearchHit": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "projection": {
          "additionalProperties": true,
          "title": "Projection",
          "type": "object"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "record_type": {
          "$ref": "#/$defs/RecordType"
        },
        "risk_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Score"
        },
        "severity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Severity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "record_type",
        "record_id",
        "created_at",
        "record_sha256",
        "projection"
      ],
      "title": "SearchHit",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "protected_content_included": {
      "default": false,
      "title": "Protected Content Included",
      "type": "boolean"
    },
    "related_records": {
      "items": {
        "$ref": "#/$defs/SearchHit"
      },
      "title": "Related Records",
      "type": "array"
    }
  },
  "required": [
    "evidence_id",
    "evidence",
    "related_records"
  ],
  "title": "EvidencePivot",
  "type": "object"
}
