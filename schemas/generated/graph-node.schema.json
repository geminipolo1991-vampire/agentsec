{
  "$defs": {
    "SecurityNodeType": {
      "enum": [
        "application",
        "agent",
        "model",
        "tool",
        "data_store",
        "source",
        "resource",
        "destination",
        "decision",
        "finding"
      ],
      "title": "SecurityNodeType",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "criticality": {
      "$ref": "#/$defs/Severity"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "node_type": {
      "$ref": "#/$defs/SecurityNodeType"
    },
    "record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Score",
      "type": "integer"
    },
    "source_ref": {
      "title": "Source Ref",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "tenant_id",
    "node_id",
    "version",
    "node_type",
    "name",
    "risk_score",
    "criticality",
    "labels",
    "source_ref",
    "valid_from",
    "record_sha256"
  ],
  "title": "SecurityGraphNode",
  "type": "object"
}
