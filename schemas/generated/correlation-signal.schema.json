{
  "$defs": {
    "AttackStage": {
      "enum": [
        "initial_access",
        "execution",
        "persistence",
        "privilege_escalation",
        "discovery",
        "collection",
        "exfiltration",
        "impact",
        "anomalous_behavior"
      ],
      "title": "AttackStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_ref": {
      "pattern": "^agent_sha256:[0-9a-f]{32}$",
      "title": "Agent Ref",
      "type": "string"
    },
    "alert_id": {
      "title": "Alert Id",
      "type": "string"
    },
    "alert_type": {
      "title": "Alert Type",
      "type": "string"
    },
    "attack_stage": {
      "$ref": "#/$defs/AttackStage"
    },
    "decision": {
      "title": "Decision",
      "type": "string"
    },
    "entity_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 2,
      "title": "Entity Refs",
      "type": "array"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidence Refs",
      "type": "array"
    },
    "finding_id": {
      "pattern": "^fnd_[A-Za-z0-9]+$",
      "title": "Finding Id",
      "type": "string"
    },
    "flow_ref": {
      "pattern": "^flow_sha256:[0-9a-f]{32}$",
      "title": "Flow Ref",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "priority": {
      "title": "Priority",
      "type": "string"
    },
    "risk_score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Risk Score",
      "type": "integer"
    },
    "severity": {
      "title": "Severity",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "finding_id",
    "alert_id",
    "event_id",
    "flow_ref",
    "agent_ref",
    "entity_refs",
    "alert_type",
    "title",
    "severity",
    "risk_score",
    "priority",
    "decision",
    "attack_stage",
    "occurred_at"
  ],
  "title": "CorrelationSignal",
  "type": "object"
}
