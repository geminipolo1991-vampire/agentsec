{
  "$defs": {
    "AiMode": {
      "enum": [
        "off",
        "shadow",
        "advisory",
        "semantic_hold"
      ],
      "title": "AiMode",
      "type": "string"
    },
    "DecisionAction": {
      "enum": [
        "allow",
        "allow_with_obligations",
        "require_approval",
        "deny"
      ],
      "title": "DecisionAction",
      "type": "string"
    },
    "ModelVerdict": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "provider",
        "model_id",
        "action",
        "confidence",
        "evidence_ids",
        "reason_codes"
      ],
      "title": "ModelVerdict",
      "type": "object"
    },
    "ModelVerdictValidation": {
      "additionalProperties": false,
      "properties": {
        "calibrated_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Calibrated Confidence",
          "type": "number"
        },
        "cited_evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Cited Evidence Ids",
          "type": "array"
        },
        "claimed_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Claimed Confidence",
          "type": "number"
        },
        "eligible_to_tighten": {
          "title": "Eligible To Tighten",
          "type": "boolean"
        },
        "human_gate_required": {
          "title": "Human Gate Required",
          "type": "boolean"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "enum": [
            "valid",
            "human_review",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "unknown_evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Unknown Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "policy_version",
        "status",
        "claimed_confidence",
        "calibrated_confidence",
        "human_gate_required",
        "eligible_to_tighten"
      ],
      "title": "ModelVerdictValidation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/DecisionAction"
    },
    "ai_mode": {
      "$ref": "#/$defs/AiMode",
      "default": "off"
    },
    "alert_id": {
      "title": "Alert Id",
      "type": "string"
    },
    "combiner_result": {
      "title": "Combiner Result",
      "type": "string"
    },
    "deterministic_action": {
      "$ref": "#/$defs/DecisionAction"
    },
    "judged_at": {
      "format": "date-time",
      "title": "Judged At",
      "type": "string"
    },
    "model_status": {
      "default": "not_requested",
      "title": "Model Status",
      "type": "string"
    },
    "model_validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelVerdictValidation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "alert_id",
    "action",
    "reason_codes",
    "deterministic_action",
    "combiner_result",
    "policy_version"
  ],
  "title": "Judgment",
  "type": "object"
}
